    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
