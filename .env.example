PORT=8787
NOTES_DIR=./workspace/notes
RESOURCES_SUBDIR=Recursos
MEMORIA_DIR=./workspace/memoria
MEMORIA_MAIN=tfg.tex
BUILD_DIR=./data/builds
# Arranque empaquetado: rutas independientes (opcionales; BUILD_DIR puede ir aparte).
# DATA_DIR=/ruta/a/datos-de-la-app
# TEMPLATES_DIR=/ruta/a/plantillas
# WEB_DIST=/ruta/a/interfaz-compilada
# TeX privado ya preparado (ruta absoluta; no cambia PATH ni usa TeX de otro bin).
# TEX_BIN_DIR=/ruta/a/tex-privado/bin
WORKER_URL=http://localhost:8090
# Motor: docker (por compatibilidad), auto (Docker y después TeX local) o local.
COMPILE_ENGINE=docker
# En Docker es necesario para cambiar Ajustes desde el navegador; elige un token propio.
AUTH_TOKEN=
# Solo Docker: carpeta padre elegible desde Ajustes como /data/home.
# Por defecto: Documents en HOME (macOS/Linux) o USERPROFILE (Windows).
# Usa una ruta absoluta existente; en Windows, barras / (sin ~ ni variables).
# HOST_HOME=C:/Users/Ana/Documents/TFG
# Sondeo de cambios: auto (Docker, UNC y /mnt/<letra>), on u off.
WATCH_POLLING=auto
# Carpetas que se pueden elegir/navegar desde Ajustes.
# Separador del sistema que ejecuta el servidor: ':' en macOS/Linux, ';' en Windows.
# Por defecto: el home del usuario. En Docker: /data/notes, /data/memoria y /data/home.
# macOS/Linux:
# ALLOWED_ROOTS=/Users/yo:/Volumes/Datos
# Windows:
# ALLOWED_ROOTS=C:\Users\yo;D:\TFG
