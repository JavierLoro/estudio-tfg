# Sondeo de cambios: auto (Docker, UNC y /mnt/<letra>), on u off.
WATCH_POLLING=auto
# Carpetas que se pueden elegir/navegar desde Ajustes.
# Separador del sistema que ejecuta el servidor: ':' en macOS/Linux, ';' en Windows.
# Por defecto: el home del usuario. En Docker: /data.
# macOS/Linux:
# ALLOWED_ROOTS=/Users/yo:/Volumes/Datos
# Windows:
# ALLOWED_ROOTS=C:\Users\yo;D:\TFG
