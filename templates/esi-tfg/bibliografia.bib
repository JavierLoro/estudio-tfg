% bibliografia.bib — Referencias en formato BibTeX.
% Cada entrada empieza por arroba, tipo (book, article, misc…) y una clave.
% Se cita en el texto con \cite{clave}.
% Solo aparecen en la memoria las referencias que se citan.
% Truco: Google Scholar o la web de la editorial dan la entrada BibTeX lista
% para copiar («Citar» → «BibTeX»).

@book{sommerville2016,
  author    = {Ian Sommerville},
  title     = {Software Engineering},
  edition   = {10th},
  publisher = {Pearson},
  address   = {Boston},
  year      = {2016},
}

@article{ejemplo-articulo,
  author  = {Ana García and Luis Pérez},
  title   = {Título del artículo},
  journal = {Nombre de la revista},
  volume  = {12},
  number  = {3},
  pages   = {45--67},
  year    = {2024},
}

@misc{ejemplo-web,
  author       = {{Nombre de la organización}},
  title        = {Título de la página web},
  howpublished = {\url{https://www.ejemplo.org}},
  note         = {Consultado el 1 de junio de 2026},
  year         = {2026},
}
