{
  "name": "estudio-tfg",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "node scripts/init.mjs",
    "install:all": "npm install --prefix server && npm install --prefix web",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix web && npm run build --prefix server",
    "start": "npm start --prefix server",
    "worker": "docker compose up -d --build worker",
    "test": "node --test scripts/*.test.mjs && npm test --prefix server",
    "test:e2e": "npm test --prefix test/e2e --",
    "template:manifest": "node scripts/template-manifest.mjs"
  }
}
